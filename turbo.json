{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "BACKEND_PORT",
    "NEXT_PUBLIC_BACKEND_URL",
    "DATABASE_URL",
    "JWT_SECRET",
    "NODE_ENV",
    "NEXT_PUBLIC_WS_URL"
  ],
  "tasks": {
    "start" : {
      "cache" : true
    },
    "build": {
      "dependsOn": ["^build" , "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**","dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true 
    },
    "db:deploy": {
      "cache": false
    }
  }
}
